# Скопируйте в .env на сервере и заполните: cp .env.example .env && nano .env
# В git файл .env НЕ кладём — там пароли.

# Домен сайта (без https://). Для проверки на своём компьютере: DOMAIN=http://localhost
DOMAIN=vegas-fit.ru

# База данных: придумайте длинный пароль (например: openssl rand -base64 24)
DB_USER=vegas
DB_PASSWORD=change-me

# Ключ подписи токенов, base64, минимум 256 бит: openssl rand -base64 64
JWT_SECRET=change-me

# Почта для писем (пример — Mail.ru, нужен "пароль для внешнего приложения"; подробности — docs/deploy.md, раздел 4)
MAIL_HOST=smtp.mail.ru
MAIL_PORT=587
MAIL_USERNAME=you@mail.ru
MAIL_PASSWORD=change-me
MAIL_FROM=Vegas <you@mail.ru>

# Какую версию образов запускать: latest или конкретный коммит (его подставляет деплой из GitHub Actions)
TAG=latest
